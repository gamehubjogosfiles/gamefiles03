␀␀␀function scr_player_freefall()
{
	landAnim = true;
	if vsp >= 2
	{
		if steppybuffer > 0
			steppybuffer--;
		else
		{
			create_particle(x + irandom_range(-25, 25), y + irandom_range(-10, 35), particle.cloudeffect, 0);
			steppybuffer = 8;
		}
		if vsp > 17
		{
			if punch_afterimage > 0
				punch_afterimage--;
			else
