			}
			break;
		
		case states.jump:
			if floor(image_index) == image_number - 1
			{
				if sprite_index == spr_fakepeppino_jumpstart
					sprite_index = spr_fakepeppino_jump;
				else if sprite_index == spr_fakepeppino_jump
					sprite_index = spr_fakepeppino_fall;
			}
			if grounded && vsp > 0
