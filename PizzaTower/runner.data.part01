		sprite_index = spr_meteorpep_flying;
	if sprite_index == spr_meteorpep_flying
	{
		if movespeed <= 20
			movespeed += 1;
		hsp = floor(-xscale * movespeed);
	}
	else
		hsp = 0;
	if (scr_solid(x - 1, y) && xscale == 1 && hsp != 0)
	{
		movespeed = 0;
