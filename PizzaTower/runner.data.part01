function scr_cutoff_get_angle(cutoff_instance)
{
	var a = cutoff_instance.image_angle + 90;
	var d = point_direction(0, 0, lengthdir_x(1, a) * cutoff_instance.image_yscale, lengthdir_y(1, a) * cutoff_instance.image_yscale);
	return d;
}
