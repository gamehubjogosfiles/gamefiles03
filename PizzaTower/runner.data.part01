boss_func = function()
{
	var eh = 0;
	var p = 0;
	with (obj_fakepepboss)
	{
		eh = elitehit;
		p = phase;
	}
	if (p == 1)
		boss_hp = eh;
	else if (p == 2)
		boss_hp = eh;
	else if (p == 0)
	{
		boss_hp = 0;
		if (room == boss_fakepephallway)
			boss_hp = 1;
	}
};
