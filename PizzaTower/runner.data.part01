function scr_vigilante_reloading()
{
	image_speed = 0.35;
	hsp = Approach(hsp, 0, 1);
	if reloadbuffer > 0
		reloadbuffer--;
	else
	{
		ammo = 6;
		sprite_index = spr_playerV_idle;
		state = states.walk;
		hsp = 0;
		cooldown = 0;
		image_xscale = (x < (room_width / 2)) ? 1 : -1;
