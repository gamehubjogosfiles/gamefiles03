	case 13:
		peppino.x += 1;
		pizzaface.x += 2;
		pizzaface.y = Wave(pizzaface.ystart - 30, pizzaface.ystart + 30, 3, 10);
		if _switch
		{
			peppino.sprite_index = spr_player_mach4;
