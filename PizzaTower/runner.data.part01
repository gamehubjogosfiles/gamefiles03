		if move != xscale && momemtum == 1 && movespeed != 0
			movespeed -= 0.05;
		if movespeed == 0
			momemtum = false;
		if move != dir && move != 0
		{
			dir = move;
			movespeed = 0;
		}
		if ((move == 0 && momemtum == 0) || scr_solid(x + hsp, y))
		{
			movespeed = 0;
			mach2 = 0;
		}
		if move != 0 && movespeed < 7
			movespeed += 0.25;
		if movespeed > 7
			movespeed -= 0.05;
		if ((scr_solid(x + 1, y) && move == 1) || (scr_solid(x - 1, y) && move == -1))
			movespeed = 0;
