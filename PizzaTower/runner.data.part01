␀␀…␀␀function scr_player_highjump()
{
	move = key_left + key_right;
	if momemtum == 0
		hsp = move * movespeed;
	else
		hsp = xscale * movespeed;
	if move == 0 && momemtum == 0
		movespeed = 0;
	if move != 0 && movespeed < 6
		movespeed += 0.5;
	if (((scr_solid(x + 1, y) && move == 1) || (scr_solid(x - 1, y) && move == -1)) && !place_meeting(x + sign(hsp), y, obj_slope))
		movespeed = 0;
