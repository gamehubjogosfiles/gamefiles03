	SHOW_COLLISIONS = new DebugCommand("SHOWCOLLISIONS", "Shows the collisions", "<bool>", function(toggle)
	{
		if toggle == undefined
			exit;
		toggle = get_bool(toggle);
		if toggle != undefined
		{
