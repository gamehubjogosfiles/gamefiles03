		vsp = 0;
		hooked = false;
	}
	if input_buffer_jump > 0
	{
		input_buffer_jump = 0;
		hooked = false;
		sprite_index = spr_jump;
		ladderbuffer = 20;
		if (place_meeting(x, y, obj_hookup))
			ladderbuffer = 30;
		jumpAnim = true;
		state = states.jump;
		if key_down
			vsp = 5;
		else
			vsp = -9;
		image_index = 0;
	}
	if (key_down && grounded && !place_meeting(x, y, obj_platform))
