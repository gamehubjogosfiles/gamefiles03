				{
					playerid.input_buffer_jump = 8;
					vsp = -14;
					if move != 0
						xscale = sign(move);
					hsp = xscale * 6;
					substate = states.jump;
				}
				break;
			case states.jump:
				if key_jump
					playerid.input_buffer_jump = 0;
				if grounded
					substate = states.normal;
