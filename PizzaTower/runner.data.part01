	}
}
␀␀␀È␀␀function scr_player_finishingblow()
{
	hsp = movespeed;
	move = key_right + key_left;
	if (floor(image_index) < 4 && sprite_index != spr_swingdingend)
		movespeed = Approach(movespeed, 0, 1);
	else
		movespeed = Approach(movespeed, -xscale * 4, 0.5);
