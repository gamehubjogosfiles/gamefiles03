			{
				vsp = -7;
				hsp = 0;
			}
		}
		with obj_camera
		{
			shake_mag = 10;
			shake_mag_acc = 30 / room_speed;
		}
		image_index = 0;
		sprite_index = spr_meteorpep_land;
	}
	if (scr_solid(x + 1, y) && xscale == -1 && hsp != 0)
	{
		movespeed = 0;
